{
  "name": "hauskat-mission-control",
  "version": "4.5.5",
  "description": "Hauskat Mission Control - Native Mac Application",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && electron-builder",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && electron-builder",
    "package": "vite build && electron-builder --linux",
    "package:mac": "vite build && electron-builder --mac",
    "icon:help": "node generate-icon.cjs",
    "test:smoke": "node tests/electron-smoke.mjs"
  },
  "keywords": [
    "electron",
    "react",
    "hauskat",
    "mission-control"
  ],
  "author": {
    "name": "Hauskat",
    "email": "hello@hauskat.com"
  },
  "license": "MIT",
  "dependencies": {
    "chokidar": "^3.6.0",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.6.2",
    "lucide-react": "^0.309.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@vitejs/plugin-react": "6.1.2",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.2",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.4.0",
    "vite": "8.3.3",
    "vite-plugin-electron": "1.1.2",
    "wait-on": "^7.2.0"
  },
  "overrides": {
    "postcss-selector-parser": "^7.1.6"
  }
}
